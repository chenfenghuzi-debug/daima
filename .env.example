# OPENCODE_API_KEY: Required for OpenCode AI API calls.
# Users configure this via the Secrets panel in the AI Studio UI.
OPENCODE_API_KEY=MY_OPENCODE_API_KEY

# SUPABASE_URL: Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
# Configure this in the AI Studio Secrets panel.
SUPABASE_URL=MY_SUPABASE_URL

# SUPABASE_ANON_KEY: Your Supabase project anon/public API key.
# Configure this in the AI Studio Secrets panel.
SUPABASE_ANON_KEY=MY_SUPABASE_ANON_KEY
